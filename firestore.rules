rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isArticleOwner(articleId) {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/articles/$(articleId)).data.ownerId == request.auth.uid;
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
      
      // User's WordPress sites subcollection
      match /wordpressSites/{siteId} {
        allow read, write: if isOwner(userId);
      }
      
      // User's templates subcollection
      match /templates/{templateId} {
        allow read, write: if isOwner(userId);
      }
      
      // User's preferences subcollection
      match /preferences/{docType} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // Sites collection
    match /sites/{siteId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow write: if isAuthenticated() && 
        (request.resource.data.ownerId == request.auth.uid || resource.data.ownerId == request.auth.uid);
    }
    
    // Articles collection
    match /articles/{articleId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow write: if isAuthenticated() && 
        (request.resource.data.ownerId == request.auth.uid || resource.data.ownerId == request.auth.uid);
      
      // Article version snapshots subcollection
      match /versions/{versionId} {
        allow read: if isArticleOwner(articleId);
        allow create: if isArticleOwner(articleId) && 
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.articleId == articleId;
        allow update, delete: if isArticleOwner(articleId) && 
          resource.data.userId == request.auth.uid;
      }
    }
  }
}
